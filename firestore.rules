rules_version = '2';

// כללי האבטחה של Firestore לסדנה.
// להדביק בקונסולה: Firestore Database → לשונית Rules → Publish.
//
// עיקרון: משתמש מחובר ניגש רק לנתונים של עצמו; מנחה (אדמין) קורא את רשימת
// המשתמשים ומנהל את מצב היחידות. רשימת המנחים כאן חייבת להיות זהה ל-ADMIN_EMAILS
// שב-app/config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // מנחה = כניסה עם Google + אימייל מאומת + אימייל מורשה.
    // הסיסמה המשותפת של הסדנה גלויה לכל דפדפן, ולכן כניסה בסיסמה לעולם לא מקנה הרשאת מנחה.
    // אימייל מורשה: בעלים (הרשימה כאן - לשמור זהה ל-ADMIN_EMAILS ב-app/config.js, אותיות קטנות),
    // או מסמך admins/{email} שמנחה הוסיף בלוח הניהול.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && (request.auth.token.email.lower() in [
              'inbaltsa@post.bgu.ac.il'
            ]
            || exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())));
    }

    // מנחים שנוספו בלחיצת כפתור. מנחה מנהל את הרשימה; כל אחד יכול רק לבדוק אם הוא עצמו ברשימה.
    match /admins/{email} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email.lower() == email);
      allow write: if isAdmin();
    }

    // פרופיל משתמש: כל אחד קורא/כותב את שלו; מנחה קורא את כולם (ללוח הניהול).
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin(); // העברת משתתפים בין קבוצות בלוח הניהול
    }

    // התקדמות (תשובות + צ'קליסטים): הבעלים קורא וכותב; מנחה קורא (מעקב קבוצה בלוח הניהול).
    match /progress/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // קבוצות (מחזורי סדנה): רק מנחה. משתתפים מצטרפים דרך activeGroup שב-workshop/config.
    match /groups/{gid} {
      allow read, write: if isAdmin();
    }

    // הגדרות הסדנה (אילו יחידות פתוחות): כולם קוראים, רק מנחה כותב.
    match /workshop/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
